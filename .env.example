# Copy to .env.local and fill in your Supabase project settings.
# Use only the public anon/publishable key here, never a service-role key.
# Without these values, pages render but online submissions are unavailable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to the actual public site origin before deployment.
NEXT_PUBLIC_SITE_URL=https://boralukatiya.lk

# NEXT_PUBLIC values are bundled at build time: rebuild after changing them.
